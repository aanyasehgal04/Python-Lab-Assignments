    "# 1. Creation\n",
    "my_dict = {\"name\": \"Alice\", \"age\": 20, \"course\": \"Computer Science\"}\n",
    "print(\"Original Dictionary:\", my_dict)\n",
    "\n",
    "# 2. Method 1: keys() - Getting all keys\n",
    "print(\"Keys:\", list(my_dict.keys()))\n",
    "\n",
    "# 3. Method 2: values() - Getting all values\n",
    "print(\"Values:\", list(my_dict.values()))\n",
    "\n",
    "# 4. Method 3: items() - Getting key-value pairs\n",
    "print(\"Items:\", list(my_dict.items()))\n",
    "\n",
    "# 5. Method 4: get() - Accessing a value safely\n",
    "print(\"Get 'name':\", my_dict.get(\"name\"))\n",
    "\n",
    "# 6. Method 5: update() / Adding & Modifying elements\n",
    "my_dict.update({\"city\": \"Pune\", \"age\": 21})\n",
    "print(\"After update():\", my_dict)\n",
    "\n",
    "# Removal operation using pop()\n",
    "removed_val = my_dict.pop(\"course\")\n",
    "print(f\"After pop('course') [removed '{removed_val}']:\", my_dict)"
