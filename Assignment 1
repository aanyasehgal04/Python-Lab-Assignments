    "# 1. Creation\n",
    "my_list = [10, 20, 30, 40, 50]\n",
    "print(\"Original List:\", my_list)\n",
    "\n",
    "# 2. Method 1: append() - Adding an element at the end\n",
    "my_list.append(60)\n",
    "print(\"After append(60):\", my_list)\n",
    "\n",
    "# 3. Method 2: insert() - Adding an element at a specific index\n",
    "my_list.insert(2, 25)\n",
    "print(\"After insert(2, 25):\", my_list)\n",
    "\n",
    "# 4. Method 3: remove() - Removing a specific element\n",
    "my_list.remove(40)\n",
    "print(\"After remove(40):\", my_list)\n",
    "\n",
    "# 5. Method 4: pop() - Removing element by index\n",
    "popped_val = my_list.pop(1)\n",
    "print(f\"Popped element at index 1 ({popped_val}):\", my_list)\n",
    "\n",
    "# 6. Method 5: reverse() - Reversing the list in-place\n",
    "my_list.reverse()\n",
    "print(\"After reverse():\", my_list)"
   ]
