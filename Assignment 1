    "# 1. Creation\n",
    "my_tuple = (10, 20, 30, 20, 40, 50)\n",
    "print(\"Original Tuple:\", my_tuple)\n",
    "\n",
    "# 2. Method 1: count() - Counting occurrences of a value\n",
    "count_20 = my_tuple.count(20)\n",
    "print(\"Count of 20 in tuple:\", count_20)\n",
    "\n",
    "# 3. Method 2: index() - Finding the index of an element\n",
    "idx = my_tuple.index(30)\n",
    "print(\"Index of 30 in tuple:\", idx)\n",
    "\n",
    "# 4. Method 3: len() - Getting length of tuple\n",
    "print(\"Length of tuple:\", len(my_tuple))\n",
    "\n",
    "# 5. Method 4: Concatenation (+) - Combining tuples\n",
    "new_tuple = my_tuple + (60, 70)\n",
    "print(\"Concatenated Tuple:\", new_tuple)\n",
    "\n",
    "# 6. Method 5: Slicing [start:stop:step]\n",
    "sliced_tuple = my_tuple[1:4]\n",
    "print(\"Sliced Tuple [1:4]:\", sliced_tuple)"
   ]
