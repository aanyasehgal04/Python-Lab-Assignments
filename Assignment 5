    "import re\n",
    "\n",
    "# Function to check if a string contains only a-z, A-Z, and 0-9\n",
    "def check_character_set(user_str):\n",
    "    # Pattern matches only alphanumeric characters from start to end\n",
    "    pattern = r'^[a-zA-Z0-9]+$'\n",
    "    \n",
    "    if re.match(pattern, user_str):\n",
    "        return True\n",
    "    else:\n",
    "        return False\n",
    "\n",
    "# --- Main Program Execution ---\n",
    "print(\"--- CHARACTER SET CHECKER ---\")\n",
    "\n",
    "# Input: Accept string from user\n",
    "input_string = input(\"Enter a string to test: \")\n",
    "\n",
    "# Function Calling & Output\n",
    "if check_character_set(input_string):\n",
    "    print(f\"SUCCESS: '{input_string}' contains ONLY valid characters (a-z, A-Z, 0-9).\")\n",
    "else:\n",
    "    print(f\"FAILURE: '{input_string}' contains invalid characters (spaces, special symbols, etc.).\")"
   ]
