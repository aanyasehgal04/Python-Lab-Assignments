   ],
   "source": [
    "# FAQ Part 1: Logical Operators Demonstration\n",
    "print(\"--- LOGICAL OPERATORS ---\")\n",
    "\n",
    "x = 10\n",
    "y = 20\n",
    "\n",
    "# 1. 'and' Operator - Returns True if BOTH conditions are True\n",
    "print(\"1. 'and' Operator Example:\")\n",
    "print(f\"   (x > 5 and y > 15) -> {x > 5 and y > 15}\")\n",
    "print(f\"   (x > 15 and y > 15) -> {x > 15 and y > 15}\\n\")\n",
    "\n",
    "# 2. 'or' Operator - Returns True if AT LEAST ONE condition is True\n",
    "print(\"2. 'or' Operator Example:\")\n",
    "print(f\"   (x > 15 or y > 15) -> {x > 15 or y > 15}\")\n",
    "print(f\"   (x > 15 or y < 10) -> {x > 15 or y < 10}\\n\")\n",
    "\n",
    "# 3. 'not' Operator - Inverts/Reverses the boolean result\n",
    "print(\"3. 'not' Operator Example:\")\n",
    "print(f\"   not(x > 5) -> {not(x > 5)}\")\n",
    "print(f\"   not(x < 5) -> {not(x < 5)}\")"
   ]
  },
