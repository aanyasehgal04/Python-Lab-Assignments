    "# Function to check if a triangle is right-angled using Pythagoras theorem\n",
    "def is_right_angled(a, b, c):\n",
    "    \"\"\"\n",
    "    Checks if three sides form a right-angled triangle.\n",
    "    Condition: (hypotenuse)^2 == (side1)^2 + (side2)^2\n",
    "    \"\"\"\n",
    "    # Sort the sides so the longest side is always at index 2\n",
    "    sides = sorted([a, b, c])\n",
    "    \n",
    "    # Check Pythagoras theorem\n",
    "    if (sides[0]**2 + sides[1]**2) == sides[2]**2:\n",
    "        return True\n",
    "    else:\n",
    "        return False\n",
    "\n",
    "# --- Main Program Execution ---\n",
    "print(\"--- RIGHT-ANGLED TRIANGLE CHECKER ---\")\n",
    "\n",
    "# Input: Accept three sides from the user\n",
    "side1 = float(input(\"Enter length of first side: \"))\n",
    "side2 = float(input(\"Enter length of second side: \"))\n",
    "side3 = float(input(\"Enter length of third side: \"))\n",
    "\n",
    "# Function Calling\n",
    "if is_right_angled(side1, side2, side3):\n",
    "    print(f\"The triangle with sides {side1}, {side2}, and {side3} IS a right-angled triangle.\")\n",
    "else:\n",
    "    print(f\"The triangle with sides {side1}, {side2}, and {side3} IS NOT a right-angled triangle.\")"
   ]
