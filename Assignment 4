   "source": [
    "# =========================================================\n",
    "# PART 1: MATRIX ADDITION USING PYTHON LISTS (NESTED LISTS)\n",
    "# =========================================================\n",
    "\n",
    "print(\"--- MATRIX ADDITION USING LISTS ---\")\n",
    "\n",
    "# Define two 3x3 matrices using lists\n",
    "matrix_a = [\n",
    "    [1, 2, 3],\n",
    "    [4, 5, 6],\n",
    "    [7, 8, 9]\n",
    "]\n",
    "\n",
    "matrix_b = [\n",
    "    [9, 8, 7],\n",
    "    [6, 5, 4],\n",
    "    [3, 2, 1]\n",
    "]\n",
    "\n",
    "# Get dimensions (rows and columns)\n",
    "rows = len(matrix_a)\n",
    "cols = len(matrix_a[0])\n",
    "\n",
    "# Initialize result matrix with zeros\n",
    "result_list = [[0 for _ in range(cols)] for _ in range(rows)]\n",
    "\n",
    "# Element-wise addition using nested loops\n",
    "for i in range(rows):\n",
    "    for j in range(cols):\n",
    "        result_list[i][j] = matrix_a[i][j] + matrix_b[i][j]\n",
    "\n",
    "print(\"Matrix A:\")\n",
    "for row in matrix_a:\n",
    "    print(row)\n",
    "\n",
    "print(\"\\nMatrix B:\")\n",
    "for row in matrix_b:\n",
    "    print(row)\n",
    "\n",
    "print(\"\\nResult (A + B using Lists):\")\n",
    "for row in result_list:\n",
    "    print(row)"
   ]
